{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSHDesktop",
  "version": "0.5.7",
  "identifier": "com.dshdesktop.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime": "runtime",
      "resources/sounds": "sounds",
      "resources/preseed-plugins": "preseed-plugins",
      "icons/128x128@2x.png": "icons/128x128@2x.png"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    }
  }
}
