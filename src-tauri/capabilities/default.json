{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for DSHDesktop windows",
  "windows": ["main", "diagnostics", "settings", "skills", "plugins", "mcp", "remote"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "notification:default",
    "autostart:default",
    "allow-get-shell-ui-state",
    "allow-get-status",
    "allow-restart-dsh",
    "allow-get-recent-logs",
    "allow-get-last-boot-timing",
    "allow-open-log-file",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-bootstrap-error",
    "allow-is-first-launch",
    "allow-zoom-ui",
    "allow-get-shell-settings",
    "allow-set-shell-settings",
    "allow-preview-completion-sound",
    "allow-list-skills",
    "allow-list-import-sources",
    "allow-import-skills",
    "allow-set-skill-enabled",
    "allow-delete-skill",
    "allow-inspect-zip-skills",
    "allow-import-zip-skills",
    "dialog:allow-open",
    "allow-list-mcp-servers",
    "allow-upsert-mcp-server",
    "allow-set-mcp-enabled",
    "allow-delete-mcp-server",
    "allow-list-mcp-import-sources",
    "allow-import-mcp-servers",
    "allow-get-plugin-status",
    "allow-list-plugins",
    "allow-search-plugins",
    "allow-install-plugin",
    "allow-uninstall-plugin",
    "allow-update-plugins",
    "allow-start-remote",
    "allow-stop-remote",
    "allow-get-remote-status",
    "allow-copy-remote-link",
    "allow-get-remote-qr",
    "allow-reset-remote-link",
    "allow-check-update",
    "allow-download-update",
    "allow-install-update",
    "allow-open-update-page",
    "allow-report-page-error",
    "allow-ui-boot-ok"
  ]
}
